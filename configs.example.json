{
  "llama_server": "llama-server",
  "port": 8089,
  "targets": {
    "12b": {
      "base_args": ["-m", "models/TARGET_12B.gguf", "-ngl", "999", "-c", "24576", "-fa", "on", "--parallel", "1", "--jinja"],
      "configs": {
        "baseline":       {"server_args": ["--spec-type", "none"]},
        "baseline_rerun": {"server_args": ["--spec-type", "none"]},
