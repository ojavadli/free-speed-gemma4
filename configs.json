{
  "llama_server": "/opt/homebrew/bin/llama-server",
  "port": 8089,
  "targets": {
    "12b": {
      "base_args": [
        "-m",
        "models/12b-target/gemma-4-12b-it-qat-q4_0.gguf",
        "-ngl",
        "19",
        "-c",
        "8192",
        "-fa",
        "on",
        "--parallel",
        "1",
        "--jinja"
      ],
      "configs": {
        "baseline": {
          "server_args": [
            "--spec-type",
            "none"
          ]
        },
        "baseline_rerun": {
          "server_args": [
            "--spec-type",
            "none"
          ]
        },
        "mtp": {
          "server_args": [
            "-md",
            "models/12b-mtp/MTP/mtp-gemma-4-12B-it-Q4_0.gguf",
            "-ngld",
            "1",
            "--spec-type",
            "draft-mtp",
            "--spec-draft-n-max",
            "4"
          ]
        },
        "ngram": {
          "server_args": [
            "--spec-type",
            "ngram-map-k4v"
          ]
        },
        "mtp_ngram": {
          "server_args": [
            "-md",
            "models/12b-mtp/MTP/mtp-gemma-4-12B-it-Q4_0.gguf",
